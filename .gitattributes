# Normalisasi line endings & binary handling
* text=auto

# Source & docs: pakai LF (konsisten lintas OS)
*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf
spark   text eol=lf
.env    text eol=lf
.env.example text eol=lf

# Binary: jangan pernah di-normalisasi
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.pdf   binary
*.zip   binary
*.gz    binary
